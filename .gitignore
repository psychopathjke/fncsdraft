# Claude Code's local settings — machine-specific permission rules and temp paths.
.claude/

# Generated list of clubs whose crest file is missing from logos/. Regenerate it
# rather than tracking it; it changes every time a logo is added.
logos/_MISSING.txt

# Probe copies of the page, written inside the project because index.html now
# loads maps.js by a relative path. The harnesses delete them; one that fails
# early may not, and a stray copy of a three-megabyte page is not a change to
# the site.
probe-*/

# Editor and OS noise
.DS_Store
Thumbs.db
*.swp

# Screenshots of the replay, written by tools/shot-replay.js. Look at them and
# throw them away; they are a way of seeing the map, not a record of it.
shot-*.png
