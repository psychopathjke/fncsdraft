# Cloudflare Pages: как кэшировать то, что отдаётся с сайта.
#
# Скрипты запрашиваются с ?v=<хеш содержимого> (см. check-deploy-folder.js —
# он не даст хешу отстать), поэтому новый файл всегда приезжает по новому
# адресу, а старый можно держать вечно. Без этого Pages отдаёт всё с
# max-age=0, must-revalidate и БЕЗ ETag: приложение на полтора мегабайта
# качается заново при каждом заходе. На тонком канале это и выглядит как
# «сайт не грузится».
/app.js
  Cache-Control: public, max-age=31536000, immutable
/zone-sim.js
  Cache-Control: public, max-age=31536000, immutable
/zone-replay.js
  Cache-Control: public, max-age=31536000, immutable
/mp.js
  Cache-Control: public, max-age=31536000, immutable
# maps.js сюда НЕ входит: он подгружается как el.src='maps.js', без ?v —
# вечный кэш заморозил бы старую копию. Появится хеш — можно добавить.
# Шрифт лежит под своим именем и не меняется — см. комментарий в <head>.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# Воркер не кэшируется никогда: браузер сверяет sw.js при каждом заходе,
# иначе новая сборка не доедет до тех, у кого он уже стоит.
/sw.js
  Cache-Control: no-cache, max-age=0, must-revalidate
